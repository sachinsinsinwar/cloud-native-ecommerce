# =============================================================================
# Environment Variables for Docker Compose
# Copy this file to .env and update values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# Security Best Practice:
# - Use strong passwords (mix of letters, numbers, symbols)
# - Never commit .env file to version control
# - Use different credentials for each environment

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_optional

# Note: Redis password is optional but recommended for production
# Leave empty for no password (development only)

# -----------------------------------------------------------------------------
# Flask Backend Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=5000
FLASK_ENV=development
# Options: development, production

# Security: SECRET_KEY for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-use-random-string

# CORS Origins (comma-separated, no spaces)
# Allow requests from these origins
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173

# -----------------------------------------------------------------------------
# React Frontend Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_INTERNAL_PORT=80
# For development: use 3000 (Vite)
# For production: use 80 (nginx)

# Frontend Build Target
# Options: development, production
FRONTEND_BUILD_TARGET=development

# API URL (backend endpoint)
VITE_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Production Environment Variables (additional)
# -----------------------------------------------------------------------------
# Uncomment and configure for production deployment

# Database (use managed service in production)
# DATABASE_URL=postgresql://user:password@your-db-host:5432/dbname

# Redis (use managed service in production)
# REDIS_URL=redis://:password@your-redis-host:6379/0

# Backend API URL (your domain)
# VITE_API_URL=https://api.yourdomain.com

# CORS (your frontend domain)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/TLS (if using https)
# FLASK_REDIRECT_TO_HTTPS=true

# =============================================================================
# Security Checklist for Production:
# =============================================================================
# ✓ Change all default passwords
# ✓ Generate strong SECRET_KEY
# ✓ Use environment-specific .env files
# ✓ Never commit .env to git (.gitignore should include it)
# ✓ Use secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
# ✓ Enable SSL/TLS certificates
# ✓ Restrict CORS_ORIGINS to your domain only
# ✓ Use managed database services (AWS RDS, Google Cloud SQL, etc.)
# ✓ Enable database backups
# ✓ Configure firewall rules
# ✓ Set up monitoring and logging
# =============================================================================

# =============================================================================
# Quick Reference:
# =============================================================================
# View all environment variables:
#   docker-compose config
#
# Override .env file:
#   docker-compose --env-file .env.production up
#
# Pass environment variables at runtime:
#   FLASK_ENV=production docker-compose up
# =============================================================================
